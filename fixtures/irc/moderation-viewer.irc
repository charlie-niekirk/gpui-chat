# The same chat as moderation.irc for someone who is not a moderator (PR 5.2): the cleared messages
# are struck through and the "was timed out" lines show, but there are no moderation controls.
#
#   cargo run -p gpui-chat --release -- --replay fixtures/irc/moderation-viewer.irc --replay-speed 0
@badge-info=;badges=;color=#00FF7F;display-name=Viewer;emote-sets=0;mod=0;subscriber=0;user-type= :tmi.twitch.tv USERSTATE #testchan
@emote-only=0;followers-only=10;r9k=0;room-id=1000;slow=0;subs-only=0 :tmi.twitch.tv ROOMSTATE #testchan
